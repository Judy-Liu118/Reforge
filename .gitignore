# FP sweep run artifacts (scripts/fp_sweep.py) — regenerable, not versioned
fp_sweep_*.jsonl
llm_judge_probe_*.jsonl

# Demo/run products written to the repo root instead of a runs/ dir — regenerable.
# demo_*.csv: LLM-generated code's pandas to_csv landing in cwd; no repo fixture
#   generator uses this prefix (gen_experience_fixtures.py / gen_sales_csv.py emit
#   differently-named files), so a demo_-prefixed CSV at root is run output.
# first_run_failed[.flag]: stray root-level run markers, no in-repo generator found.
demo_*.csv
first_run_failed
first_run_failed.flag

# Memory-transfer probe corpus — regenerated by scripts/build_memory_probe_data.py
# (build_mp1_columns/build_mp3_files rewrite the CSVs; build_mp2_tables deletes and
# rebuilds mp_warehouse.db every run). The generator + prereg doc are what should
# be versioned, not this output.
benchmark_data/mp_*
